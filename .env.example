# Copy to .env and fill in. Never commit .env.
# Required — the app refuses to start without these (app/config.py).
LLM_API_KEY=
HF_TOKEN=

# The chat provider is any OpenAI-compatible /chat/completions endpoint.
# Default: OpenRouter free tier, key = sk-or-v1-...
#   MAIN_MODEL=openrouter/free picks an available free model that supports the
#   features of each request (tools, images), so one model being down is survivable.
#   Free variants are capped at 20 requests/minute and 50/day under $10 of lifetime credit.
# Other endpoints, measured 2026-09-11:
# LLM_BASE_URL=https://router.huggingface.co/v1        # key = HF token, small monthly credit
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1     # key = nvapi-..., slow (38-120 s/turn)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  # needs LLM_PROXY_URL
#
# If turns keep dying with "Request timed out" before any token arrives, the TCP connect is
# being dropped, not the model. Measured from this machine on 2026-09-11: 4 of 8 connections
# to openrouter.ai and to integrate.api.nvidia.com never complete the handshake, while
# router.huggingface.co is 8 of 8. Setting LLM_PROXY_URL routes around it.

# Optional overrides; defaults live in app/config.py.
# LLM_PROXY_URL=http://127.0.0.1:1081
# LLM_TIMEOUT=120
# MAIN_MODEL=openrouter/free
# SUMMARY_MODEL=inclusionai/ling-3.0-flash-fin:free
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cuda        # unset = let sentence-transformers pick
# EMBEDDING_BATCH_SIZE=16
# CHUNK_SIZE=3000              # characters, not tokens
# OVERLAP=300
# STORAGE_DIR=app/storage
