# Copy to .env and fill in. Never commit .env.
# Required — the app refuses to start without these (app/config.py).
GEMINI_API_KEY=
HF_TOKEN=

# Optional overrides; defaults live in app/config.py.
# GEMINI_PROXY_URL=http://127.0.0.1:1081
# MAIN_MODEL=gemma-4-26b-a4b-it
# SUMMARY_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cuda        # unset = let sentence-transformers pick
# EMBEDDING_BATCH_SIZE=16
# CHUNK_SIZE=3000              # characters, not tokens
# OVERLAP=300
# STORAGE_DIR=app/storage
